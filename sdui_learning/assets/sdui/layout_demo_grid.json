{
  "id": "layout_demo",
  "title": "Dynamic Layout (Grid)",
  "background": "#0F0F12",
  "root": {
    "type": "column",
    "props": {
      "padding": 20,
      "gap": 16,
      "crossAxisAlignment": "stretch"
    },
    "children": [
      {
        "type": "text",
        "props": {
          "value": "Layout demo (grid)",
          "fontSize": 24,
          "bold": true,
          "color": "#FFFFFF"
        }
      },
      {
        "type": "text",
        "props": {
          "value": "Same content as column version — arranged in a GridView. Paste this document over screens/layout_demo to switch live.",
          "fontSize": 14,
          "color": "#B0B0B0",
          "height": 1.4
        }
      },
      {
        "type": "grid",
        "props": {
          "crossAxisCount": 2,
          "gap": 12,
          "childAspectRatio": 0.85
        },
        "children": [
          {
            "type": "container",
            "props": {
              "color": "#1E1E24",
              "padding": 12,
              "radius": 16
            },
            "children": [
              {
                "type": "column",
                "props": { "gap": 8 },
                "children": [
                  {
                    "type": "text",
                    "props": {
                      "value": "Title",
                      "fontSize": 16,
                      "bold": true,
                      "color": "#E8B84B"
                    }
                  },
                  {
                    "type": "text",
                    "props": {
                      "value": "Subtitle",
                      "fontSize": 13,
                      "color": "#FFFFFF"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "image",
            "props": {
              "url": "https://images.unsplash.com/photo-1574607383476-f517f260d9b1?w=800&q=80",
              "height": 140,
              "radius": 16
            }
          },
          {
            "type": "container",
            "props": {
              "color": "#C45C26",
              "padding": 12,
              "radius": 12
            },
            "children": [
              {
                "type": "text",
                "props": { "value": "Card A", "color": "#FFFFFF", "bold": true }
              }
            ]
          },
          {
            "type": "container",
            "props": {
              "color": "#7B1E3A",
              "padding": 12,
              "radius": 12
            },
            "children": [
              {
                "type": "text",
                "props": { "value": "Card B", "color": "#FFFFFF", "bold": true }
              }
            ]
          },
          {
            "type": "container",
            "props": {
              "color": "#E91E8C",
              "padding": 12,
              "radius": 12
            },
            "children": [
              {
                "type": "text",
                "props": { "value": "Card C", "color": "#FFFFFF", "bold": true }
              }
            ]
          }
        ]
      }
    ]
  }
}
